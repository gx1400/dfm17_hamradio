# Editor settings; tools/lint/check_eol.sh enforces the line endings in CI.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = tab
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.sh]
indent_style = tab
indent_size = 4

[*.py]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Generated by STM32CubeMX: keep its CRLF line endings and layout
[dfm17/{.mxproject,Core/Startup/*.s}]
end_of_line = crlf
[dfm17/Core/{Inc,Src}/{main,dma,gpio,spi,tim,usart,stm32f1xx_it,stm32f1xx_hal_msp,system_stm32f1xx,stm32f1xx_hal_conf}.{c,h}]
end_of_line = crlf
indent_style = unset
indent_size = unset

# Vendor code from ST: leave as delivered
[dfm17/Drivers/**]
end_of_line = unset
indent_style = unset
indent_size = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

# Raw data
[docs/data/**]
trim_trailing_whitespace = unset
insert_final_newline = unset
